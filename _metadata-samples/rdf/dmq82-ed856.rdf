      </ns3:hasSubject>
      <ns3:hasSubject>
         <rdf:Description xmlns:ns0="http://purl.org/dc/terms/"
                          xmlns:ns1="http://www.w3.org/2004/02/skos/core#"
                          xmlns:ns2="https://model.ccmm.cz/vocabulary/datacite#"
