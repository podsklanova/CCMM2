            <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#Subject"/>
            <ns0:title rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                       xml:lang="en">Directed energy deposition</ns0:title>
         </rdf:Description>
      </ns3:hasSubject>
      <ns3:hasSubject>
         <rdf:Description xmlns:ns0="http://purl.org/dc/terms/"
                          xmlns:ns1="http://www.w3.org/2004/02/skos/core#"
                          xmlns:ns2="https://model.ccmm.cz/vocabulary/datacite#"
                          xmlns:ns3="https://model.ccmm.cz/vocabulary/ccmm#"
                          rdf:nodeID="d44e810">
            <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#Subject"/>
            <ns0:title rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                       xml:lang="en">Laser power</ns0:title>
         </rdf:Description>
      </ns3:hasSubject>
      <ns3:hasDescription>
         <rdf:Description xmlns:ns0="https://model.ccmm.cz/vocabulary/datacite#" rdf:nodeID="d44e819">
            <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#Description"/>
            <ns0:descriptionText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                                 xml:lang="en">Industry applications of duplex stainless steels require a two-phase microstructure with a nearly balanced austenite-ferrite content to achieve good mechanical properties and good corrosion resistance. The most widespread additive manufacturing method such as laser powder bed fusion provides nearly fully ferritic microstructures due to the very high cooling rate, and the post-processing heat treatment must be performed. In contrast, other additive manufacturing methods, such as directed deposition methods, reach lower cooling rates and enable to obtain an equal ferrite–austenite ratio directly in the microstructure of the as-built state. In this work, the super duplex stainless steel SAF 2507 was deposited by directed energy deposition. The process parameters, namely, the laser power, laser beam spot, and powder feed rate, were varied to investigate the impact of the energy area density on the microstructure and tensile properties. A decrease in the energy area density caused an increase in the austenite content of 48 vol% and a numerical simulation of the sample temperature distribution inside the block during deposition, explaining the relationship between the amount of in situ formed austenite and the deposition parameters, was provided. Simultaneously, the deposition rate increased by more than five times. In contrast, the samples deposited at a higher building rate are characterized by greater porosity and lower elongation values in the vertical direction. The effect of the deposition parameters on the yield strength is low.</ns0:descriptionText>
            <ns0:hasDescriptionType>
               <rdf:Description xmlns:ns0="http://www.w3.org/2000/01/rdf-schema#"
                                rdf:about="https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Abstract">
                  <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#DescriptionType"/>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="en">Abstract</ns0:label>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="cs">Abstrakt</ns0:label>
               </rdf:Description>
            </ns0:hasDescriptionType>
         </rdf:Description>
      </ns3:hasDescription>
      <ns3:hasDescription>
         <rdf:Description xmlns:ns0="https://model.ccmm.cz/vocabulary/datacite#" rdf:nodeID="d44e836">
            <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#Description"/>
            <ns0:descriptionText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                                 xml:lang="en">The data set is related to the investigation of the influence of deposition parameters on the microstructure, austenite formation, and tensile properties of SAF 2507 super duplex stainless steel fabricated using directed energy deposition (DED). The experiments were carried out at COMTES FHT (Czech Republic) using an INSSTEK MX-600 system equipped with a 2 kW Yttrium fiber laser. SAF 2507 powder (particle size 45–150 μm) was deposited under three different parameter sets, varying laser power, beam diameter, layer thickness, hatch distance, and powder feed rate, while maintaining constant scan speed. A zig-zag deposition strategy was applied under a protective argon atmosphere (5.0, 99.999%). For each parameter set, 20×20×20 mm cubes were built and used for analysis. Microstructure and phase composition were characterized using optical microscopy, scanning electron microscopy, EBSD analysis, X-ray diffraction. Tensile properties were evaluated using miniature tensile tests. Thermal simulations of the deposition process were carried out using Simufact Welding 2024.1 with the Advanced Thermal Cycle (ATC) method.</ns0:descriptionText>
            <ns0:hasDescriptionType>
               <rdf:Description xmlns:ns0="http://www.w3.org/2000/01/rdf-schema#"
                                rdf:about="https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Methods">
                  <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#DescriptionType"/>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="en">Methods</ns0:label>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="cs">Metodologie</ns0:label>
               </rdf:Description>
            </ns0:hasDescriptionType>
         </rdf:Description>
      </ns3:hasDescription>
      <ns3:hasDescription>
         <rdf:Description xmlns:ns0="https://model.ccmm.cz/vocabulary/datacite#" rdf:nodeID="d44e853">
            <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#Description"/>
            <ns0:descriptionText rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                                 xml:lang="en">The sets of experimental data were recorded on several instruments within COMTES FHT. In cases where possible (XRD, MTT, EBSD), the data are in xlsx format enabling any replotting.</ns0:descriptionText>
            <ns0:hasDescriptionType>
               <rdf:Description xmlns:ns0="http://www.w3.org/2000/01/rdf-schema#"
                                rdf:about="https://vocabs.ccmm.cz/registry/codelist/DescriptionType/TechnicalInfo">
                  <rdf:type rdf:resource="https://model.ccmm.cz/vocabulary/datacite#DescriptionType"/>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="en">Technical Info</ns0:label>
                  <ns0:label rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#langString"
                             xml:lang="cs">Technická informace</ns0:label>
               </rdf:Description>
            </ns0:hasDescriptionType>
         </rdf:Description>
      </ns3:hasDescription>
