        <https://model.ccmm.cz/vocabulary/ccmm#qualifiedRelation>
                [ rdf:type     <https://model.ccmm.cz/vocabulary/ccmm#ResourceToAgentRelationship> ;
                  <http://purl.org/dc/terms/relation>
                          [ rdf:type  <http://www.w3.org/ns/prov#Person> ;
                            <http://www.w3.org/2006/vcard/ns#family-name>
                                    "Novák" ;
                            <http://www.w3.org/2006/vcard/ns#given-name>
                                    "Pavel" ;
                            ns1:name  "Novák, Pavel" ;
                            <https://model.ccmm.cz/vocabulary/ccmm#hasAffiliation>
                                    [ rdf:type  <http://www.w3.org/ns/prov#Organization> , ns1:Agent ;
                                      ns1:name  "Vysoká škola chemicko-technologická v Praze" ;
                                      <https://model.ccmm.cz/vocabulary/ccmm#hasIdentifier>
                                              <https://ror.org/05ggn0a85> ;
                                      <https://model.ccmm.cz/vocabulary/ccmm#hasIdentifier>
                                              [ rdf:type  <http://www.w3.org/ns/adms#Identifier> ;
                                                <http://www.w3.org/2004/02/skos/core#notation>
                                                        "60461373" ;
                                                <https://model.ccmm.cz/vocabulary/ccmm#inScheme>
                                                        <https://www.wikidata.org/entity/Q42302581>
                                              ]
                                    ] ;
                            <https://model.ccmm.cz/vocabulary/ccmm#hasIdentifier>
                                    <https://orcid.org/0000-0001-9947-2566>
                          ] ;
                  ns3:hadRole  <https://vocabs.ccmm.cz/registry/codelist/AgentRole/Creator>
                ] ;
        <https://model.ccmm.cz/vocabulary/datacite#hasDescription>
                [ rdf:type  <https://model.ccmm.cz/vocabulary/datacite#Description> ;
                  <https://model.ccmm.cz/vocabulary/datacite#descriptionText>
                          "Industry applications of duplex stainless steels require a two-phase microstructure with a nearly balanced austenite-ferrite content to achieve good mechanical properties and good corrosion resistance. The most widespread additive manufacturing method such as laser powder bed fusion provides nearly fully ferritic microstructures due to the very high cooling rate, and the post-processing heat treatment must be performed. In contrast, other additive manufacturing methods, such as directed deposition methods, reach lower cooling rates and enable to obtain an equal ferrite–austenite ratio directly in the microstructure of the as-built state. In this work, the super duplex stainless steel SAF 2507 was deposited by directed energy deposition. The process parameters, namely, the laser power, laser beam spot, and powder feed rate, were varied to investigate the impact of the energy area density on the microstructure and tensile properties. A decrease in the energy area density caused an increase in the austenite content of 48 vol% and a numerical simulation of the sample temperature distribution inside the block during deposition, explaining the relationship between the amount of in situ formed austenite and the deposition parameters, was provided. Simultaneously, the deposition rate increased by more than five times. In contrast, the samples deposited at a higher building rate are characterized by greater porosity and lower elongation values in the vertical direction. The effect of the deposition parameters on the yield strength is low."^^rdf:langString ;
                  <https://model.ccmm.cz/vocabulary/datacite#hasDescriptionType>
                          <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Abstract>
                ] ;
        <https://model.ccmm.cz/vocabulary/datacite#hasDescription>
                [ rdf:type  <https://model.ccmm.cz/vocabulary/datacite#Description> ;
                  <https://model.ccmm.cz/vocabulary/datacite#descriptionText>
                          "The sets of experimental data were recorded on several instruments within COMTES FHT. In cases where possible (XRD, MTT, EBSD), the data are in xlsx format enabling any replotting."^^rdf:langString ;
                  <https://model.ccmm.cz/vocabulary/datacite#hasDescriptionType>
                          <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/TechnicalInfo>
                ] ;
        <https://model.ccmm.cz/vocabulary/datacite#hasDescription>
                [ rdf:type  <https://model.ccmm.cz/vocabulary/datacite#Description> ;
                  <https://model.ccmm.cz/vocabulary/datacite#descriptionText>
                          "The data set is related to the investigation of the influence of deposition parameters on the microstructure, austenite formation, and tensile properties of SAF 2507 super duplex stainless steel fabricated using directed energy deposition (DED). The experiments were carried out at COMTES FHT (Czech Republic) using an INSSTEK MX-600 system equipped with a 2 kW Yttrium fiber laser. SAF 2507 powder (particle size 45–150 μm) was deposited under three different parameter sets, varying laser power, beam diameter, layer thickness, hatch distance, and powder feed rate, while maintaining constant scan speed. A zig-zag deposition strategy was applied under a protective argon atmosphere (5.0, 99.999%). For each parameter set, 20×20×20 mm cubes were built and used for analysis. Microstructure and phase composition were characterized using optical microscopy, scanning electron microscopy, EBSD analysis, X-ray diffraction. Tensile properties were evaluated using miniature tensile tests. Thermal simulations of the deposition process were carried out using Simufact Welding 2024.1 with the Advanced Thermal Cycle (ATC) method."^^rdf:langString ;
                  <https://model.ccmm.cz/vocabulary/datacite#hasDescriptionType>
                          <https://vocabs.ccmm.cz/registry/codelist/DescriptionType/Methods>
                ] ;
        <https://model.ccmm.cz/vocabulary/datacite#hasFundingReference>
                [ rdf:type  <https://model.ccmm.cz/vocabulary/datacite#FundingReference> ;
                  <https://model.ccmm.cz/vocabulary/ccmm#fundingProgram>
                          "Operační program Jan Amos Komenský"^^<http://www.w3.org/2001/XMLSchema#anyURI> ;
                  <https://model.ccmm.cz/vocabulary/datacite#awardNumber>
                          "EH23_021/0008433" ;
                  <https://model.ccmm.cz/vocabulary/datacite#awardTitle>
                          "Development of special wire semiproducts for welding and 3D printing" ;
                  <https://model.ccmm.cz/vocabulary/datacite#hasFunderIdentifier>
                          [ rdf:type  <http://www.w3.org/ns/prov#Organization> , ns1:Agent ;
                            <http://www.w3.org/2006/vcard/ns#organization-name>
                                    "Ministry of Education, Youth and Sports of the Czech Republic"@en ;
                            ns1:name  "Ministerstvo školství, mládeže a tělovýchovy" ;
                            <https://model.ccmm.cz/vocabulary/ccmm#hasIdentifier>
                                    <https://ror.org/037n8p820> , <http://dx.doi.org/10.13039/501100001823>
                          ]
                ] ;
